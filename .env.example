# Copy this file to .env and fill in the values.  NEVER commit .env.
#   cp .env.example .env

# --- GitHub (Phase 1) ---------------------------------------------------
# Classic token with NO scopes ticked is enough for public data
# (or a fine-grained token with "Public repositories (read-only)").
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Study window and sample size (RQ1 design)
COLLECT_START=2025-01-01
COLLECT_END=2026-10-31
TARGET_PRS=1500

# --- Oracle Database 23ai Free (Phase 0, 3, 6) -------------------------
ORACLE_DSN=localhost:1521/FREEPDB1
# Admin account, used only by src/00_setup_db.py to create the app user
ORACLE_ADMIN_USER=system
ORACLE_ADMIN_PASSWORD=ChangeMe_Admin123
# Application schema used by every other script
ORACLE_USER=uas_vec
ORACLE_PASSWORD=ChangeMe_App123
# Path INSIDE the container where ./models is mounted
ORACLE_MODEL_DIR_PATH=/opt/oracle/models
ONNX_MODEL_FILE=all_MiniLM_L12_v2.onnx

# --- LLM for RAG / zero-shot classification (Phase 6) ------------------
# provider: gemini | openai | anthropic   (decided before Phase 6)
LLM_PROVIDER=gemini
LLM_MODEL=
LLM_API_KEY=
